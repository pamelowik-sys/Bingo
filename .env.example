# Скопируй этот файл в .env и заполни своими данными
# cp .env.example .env

# 24 слова от твоего TON кошелька (НИКОМУ НЕ ПОКАЗЫВАЙ!)
WALLET_MNEMONIC=слово1 слово2 слово3 слово4 слово5 слово6 слово7 слово8 слово9 слово10 слово11 слово12 слово13 слово14 слово15 слово16 слово17 слово18 слово19 слово20 слово21 слово22 слово23 слово24

# Процент комиссии (0.5 = 0.5%)
COMMISSION_PERCENT=0.5

# Адрес кошелька куда переводить платежи за вычетом комиссии
RECEIVER_ADDRESS=EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
