# Скопируй этот файл в .env и заполни своими данными
# cp .env.example .env

# ─── TELEGRAM ─────────────────────────────────────────────────────────────
# Токен бота — получи через @BotFather в Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── TON КОШЕЛЁК ──────────────────────────────────────────────────────────
# Твой TON адрес (hex формат) — сюда будут приходить реферальные комиссии
# Узнай адрес в @wallet боте в Telegram или в Tonkeeper
REFERRER_TON_ADDRESS=EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API ключ Toncenter — получи через @toncenter в Telegram (нужен для свапов)
# Без ключа работает с ограничениями (1 запрос/сек)
TONCENTER_API_KEY=

# ─── НАСТРОЙКИ КОМИССИИ ────────────────────────────────────────────────────
# Реферальная комиссия в basis points (30 = 0.30%)
# Максимум для всех DEX: 100 bps (1%)
# DEX v1 ограничен 10 bps, v2/DeDust/Tonco поддерживают до 100 bps
REFERRER_FEE_BPS=30

# Максимальное проскальзывание в basis points (100 = 1%)
SLIPPAGE_BPS=100

# ─── ТЕСТОВЫЙ РЕЖИМ ────────────────────────────────────────────────────────
# Поставь "true" для тестирования на testnet (без реальных денег)
USE_SANDBOX=false
